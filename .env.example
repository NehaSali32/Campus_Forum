# =========================================================================
# Campus Forum - Environment Variables Example
# Copy this file to .env and configure your local or production values.
# NEVER commit the actual .env file containing secrets!
# =========================================================================

# Database Configuration
DB_URL=jdbc:mysql://localhost:3306/campus_connect_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=your_mysql_password_here

# Server Port
PORT=8080

# Production Profile (optional: dev / prod)
SPRING_PROFILES_ACTIVE=prod

# Set a unique, strong password before first production startup.
ADMIN_EMAIL=admin@campusforum.edu
ADMIN_PASSWORD=

# Seed Development Sample Data (false for production, true for dev)
SEED_DEMO_DATA=false

# File Upload Directory
UPLOAD_DIR=uploads
